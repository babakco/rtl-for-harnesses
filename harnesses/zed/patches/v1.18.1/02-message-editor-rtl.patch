 pub struct MessageEditorAddon {}
 
+/// ZED-RTL: true when `text` holds at least one strongly RTL character
+/// (Persian/Arabic/Hebrew ranges or an explicit RTL mark).
+/// Duplicated from `markdown::rtl` on purpose so this patch adds no
+/// cross-crate dependency to `agent_ui`.
+fn message_editor_contains_rtl(text: &str) -> bool {
+    text.chars().any(|c| {
+        matches!(c,
+            '\u{0590}'..='\u{08FF}'
+            | '\u{FB50}'..='\u{FDFF}'
+            | '\u{FE70}'..='\u{FEFF}'
+            | '\u{200F}'
+            | '\u{202B}'
+            | '\u{202E}'
+            | '\u{2066}'..='\u{2069}'
+        )
+    })
+}
