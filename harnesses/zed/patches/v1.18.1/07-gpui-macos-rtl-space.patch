+/// ZED-RTL: true when `text` holds at least one strongly RTL character.
+/// Same ranges as the row rule used by the editor/markdown RTL patches.
+fn text_has_rtl_char(text: &str) -> bool {
+    text.chars().any(|c| {
+        matches!(c,
+            '\u{0590}'..='\u{08FF}'
+            | '\u{FB50}'..='\u{FDFF}'
+            | '\u{FE70}'..='\u{FEFF}'
+            | '\u{200F}'
+            | '\u{202B}'
+            | '\u{202E}'
+            | '\u{2066}'..='\u{2069}'
+        )
+    })
+}
