 use super::*;
+use language::Point;
+use multi_buffer::MultiBufferRow;
+
+/// ZED-RTL: true when the caret's buffer row holds at least one strongly RTL
+/// character (Persian/Arabic/Hebrew). The Unicode range table is duplicated
+/// here on purpose so low-level editor code gains no new crate dependency.
+fn caret_row_is_rtl(map: &DisplaySnapshot, point: DisplayPoint) -> bool {
+    let buffer_point = point.to_point(map);
+    let snapshot = map.buffer_snapshot();
+    let end = snapshot.line_len(MultiBufferRow(buffer_point.row));
+    let text: String = snapshot
+        .text_for_range(Point::new(buffer_point.row, 0)..Point::new(buffer_point.row, end))
+        .collect();
+    text.chars().any(|c| {
+        matches!(c,
+            '\u{0590}'..='\u{08FF}'
+            | '\u{FB50}'..='\u{FDFF}'
+            | '\u{FE70}'..='\u{FEFF}'
+            | '\u{200F}'
+            | '\u{202B}'
+            | '\u{202E}'
+            | '\u{2066}'..='\u{2069}'
+        )
+    })
+}
 
