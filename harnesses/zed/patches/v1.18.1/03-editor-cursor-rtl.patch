+/// ZED-RTL: true when `text` holds at least one strongly RTL character
+/// (Persian/Arabic/Hebrew ranges or an explicit RTL mark).
+/// Duplicated from `markdown::rtl` on purpose: `editor` is a low-level crate
+/// and must not depend on `markdown`.
+fn line_text_is_rtl(text: &str) -> bool {
+    text.chars().any(|c| {
+        matches!(c,
+            '\u{0590}'..='\u{08FF}'
+            | '\u{FB50}'..='\u{FDFF}'
+            | '\u{FE70}'..='\u{FEFF}'
+            | '\u{200F}'
+            | '\u{202B}'
+            | '\u{202E}'
+            | '\u{2066}'..='\u{2069}'
+        )
+    })
+}
