diff --git a/apps/examples/desktop-app/webview/lib/rtl.test.ts b/apps/examples/desktop-app/webview/lib/rtl.test.ts
new file mode 100644
index 0000000..628443c
--- /dev/null
+++ b/apps/examples/desktop-app/webview/lib/rtl.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, test } from "vitest";
+import { containsPersian } from "./rtl";
+
+describe("containsPersian", () => {
+	test("detects a Persian word", () => {
+		expect(containsPersian("\u0633\u0644\u0627\u0645")).toBe(true);
+	});
+
+	test("detects Persian later in an English-led sentence", () => {
+		expect(containsPersian("Hello world \u0633\u0644\u0627\u0645 \u062f\u0646\u06cc\u0627")).toBe(true);
+	});
+
+	test("detects Persian after leading punctuation or symbols", () => {
+		expect(containsPersian("... \u0633\u0644\u0627\u0645")).toBe(true);
+		expect(containsPersian(">>> next step: \u0646\u0635\u0628")).toBe(true);
+	});
+
+	test("detects a lone Persian character inside code-like text", () => {
+		expect(containsPersian("const x = 1; // \u06cc")).toBe(true);
+	});
+
+	test("rejects English-only text", () => {
+		expect(containsPersian("Hello world, fix the failing test.")).toBe(false);
+	});
+
+	test("rejects empty and whitespace-only text", () => {
+		expect(containsPersian("")).toBe(false);
+		expect(containsPersian("   \n\t  ")).toBe(false);
+	});
+
+	test("rejects digits and punctuation without Persian letters", () => {
+		expect(containsPersian("123?!...")).toBe(false);
+	});
+});
diff --git a/apps/examples/desktop-app/webview/lib/rtl.ts b/apps/examples/desktop-app/webview/lib/rtl.ts
new file mode 100644
index 0000000..62253d8
--- /dev/null
+++ b/apps/examples/desktop-app/webview/lib/rtl.ts
@@ -0,0 +1,26 @@
+const PERSIAN_CHARACTER_PATTERN =
+	/[\u0600-\u06FF\u0750-\u077F\u08A0-\u08FF\uFB50-\uFDFF\uFE70-\uFEFF\u200C\u200D]/;
+
+export function containsPersian(value: string): boolean {
+	return PERSIAN_CHARACTER_PATTERN.test(value);
+}
+
+const RTL_BLOCK_SELECTOR = "p, li, h1, h2, h3, h4, h5, h6, blockquote, td, th";
+
+const LTR_ONLY_SELECTOR = "pre, code, [data-streamdown='code-block']";
+
+export function applyRtlToMarkdownRoot(root: Element): void {
+	if (!(root instanceof HTMLElement)) {
+		return;
+	}
+	const blocks = root.querySelectorAll(RTL_BLOCK_SELECTOR);
+	blocks.forEach((block) => {
+		if (!(block instanceof HTMLElement)) {
+			return;
+		}
+		if (block.closest(LTR_ONLY_SELECTOR)) {
+			return;
+		}
+		block.dir = containsPersian(block.textContent ?? "") ? "rtl" : "ltr";
+	});
+}
